[req]
distinguished_name = dn
x509_extensions    = v3
prompt             = no

[dn]
CN = ClearMind Medical (prototype)
O  = ClearMind Medical
C  = US

[v3]
subjectAltName   = @alt
basicConstraints = critical, CA:FALSE
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt]
DNS.1 = localhost
IP.1  = 127.0.0.1
# Add the machine's own LAN address here before generating, so the cert
# is valid for the URL a phone on the same network actually opens.
# IP.2  = 10.0.0.0
